# Copy to .env before starting docker-compose. Never commit the populated .env file.

# --- Database -----------------------------------------------------------
LCIT_SIGN_DB_PASSWORD=change-me-in-dev

# --- Application ----------------------------------------------------------
LCIT_SIGN_ENVIRONMENT=development
LCIT_SIGN_LOG_LEVEL=INFO

# --- Sessions / SSO --------------------------------------------------------
LCIT_SIGN_SESSION_SECRET=change-me-to-a-long-random-value
# false only for plain-http local dev; must be true behind real TLS.
LCIT_SIGN_COOKIE_SECURE=false
LCIT_SIGN_PUBLIC_BASE_URL=http://localhost:4180

# Defaults point at the bundled mock-oidc dev provider
# (docker compose --profile dev-sso up). Replace for a real provider.
LCIT_SIGN_OIDC_ISSUER=http://mock-oidc:8080
LCIT_SIGN_OIDC_CLIENT_ID=lcit-sign-dev
LCIT_SIGN_OIDC_CLIENT_SECRET=dev-secret-not-for-prod

# Email granted ADMIN on every login while this is set. Unset once a real
# administrator has taken over the account (spec §16).
LCIT_SIGN_BOOTSTRAP_ADMIN=alice.martin@lcit-test.local

# --- Signing / credential encryption ---------------------------------------
# Every signing key's private Ed25519 seed is derived from this at runtime
# (never persisted) — a real deployment needs a long random value, kept
# outside Postgres and outside this file once populated.
LCIT_SIGN_MASTER_KEY=change-me-to-a-long-random-value

# In production, prefer files (Docker/Kubernetes secrets) over variables:
# LCIT_SIGN_MASTER_KEY_FILE=/run/secrets/lcit_sign_master_key
# LCIT_SIGN_SESSION_SECRET_FILE=/run/secrets/lcit_sign_session_secret
# LCIT_SIGN_OIDC_CLIENT_SECRET_FILE=/run/secrets/lcit_sign_oidc_client_secret

# --- HTTPS ---------------------------------------------------------------
# Name users reach the installation at (self-signed fallback certificate and
# scripts/certificate-installer.sh).
# LCIT_SIGN_FQDN=sign.example.org
# Directory holding tls.crt / tls.key, managed by certificate-installer.sh.
# CREATE IT YOURSELF before the first `docker compose up` (otherwise Docker
# creates it as root):   mkdir -p -m 700 certs
# LCIT_SIGN_CERT_DIR=./certs
# LCIT_SIGN_HTTPS_PORT=4443
