# Defaults of the CrashTest stack (tests/crashtest/start.sh): a separate project, its own database and
# volumes, the mock SSO and fictional accounts. Nothing here is a secret and none of it is for
# anything but tests. Anything exported in the shell wins over these values, e.g. to put it on
# another port or under another name:
#
#   LCIT_SIGN_PREFIX=lcit-sign-feature LCIT_SIGN_HTTPS_PORT=4444 LCIT_SIGN_HTTPS_BIND=0.0.0.0 \
#   LCIT_SIGN_PUBLIC_BASE_URL=https://192.168.1.5:4444 LCIT_SIGN_COOKIE_SECURE=true \
#   ./tests/crashtest/start.sh
#
# The project name (and so the names of the containers and volumes) is the prefix: it must never be
# "lcit-sign", the name of a normal installation.
LCIT_SIGN_PREFIX=lcit-sign-crashtest
LCIT_SIGN_HTTP_PORT=4280
LCIT_SIGN_HTTPS_PORT=4444
LCIT_SIGN_HTTPS_BIND=127.0.0.1
LCIT_SIGN_PUBLIC_BASE_URL=http://127.0.0.1:4280
LCIT_SIGN_COOKIE_SECURE=false
LCIT_SIGN_DB_PASSWORD=crashtest-only-password
LCIT_SIGN_MASTER_KEY=crashtest-only-master-key-not-a-secret
LCIT_SIGN_SESSION_SECRET=crashtest-only-session-secret
LCIT_SIGN_RATE_LIMIT_ENABLED=false
LCIT_SIGN_NOTIFICATION_WORKER_INTERVAL_SECONDS=3
# An empty folder: the mock SSO must never read the real secrets of a machine.
LCIT_SIGN_SECRETS_DIR=./tests/crashtest/no-secrets
