# The throwaway CrashTest stack of the end-to-end tests (scripts/e2e.sh): its own names, ports and
# volumes, plain HTTP on a loopback port, the mock SSO. Nothing here is a secret, and none of it is for
# anything but tests.
LCIT_SIGN_PREFIX=lcit-e2e
LCIT_SIGN_HTTP_PORT=14180
LCIT_SIGN_HTTPS_PORT=14443
LCIT_SIGN_HTTPS_BIND=127.0.0.1
LCIT_SIGN_PUBLIC_BASE_URL=http://127.0.0.1:14180
LCIT_SIGN_COOKIE_SECURE=false
LCIT_SIGN_DB_PASSWORD=e2e-only-password
LCIT_SIGN_MASTER_KEY=e2e-only-master-key-not-a-secret
LCIT_SIGN_RATE_LIMIT_ENABLED=false
LCIT_SIGN_NOTIFICATION_WORKER_INTERVAL_SECONDS=3
